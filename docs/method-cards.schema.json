{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-model-lightweight-platform/docs/method-cards.schema.json",
  "title": "Compression method cards",
  "description": "Structured content for the 「压缩方法」 page cards. The frontend renders these objects directly (frontend/src/components/lab/method-cards.json); no card copy is hardcoded in JSX. Numbers under `evidence` must come from a real run recorded in docs/compression-eval-report.md.",
  "type": "object",
  "required": ["version", "generatedAt", "cards"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "description": "ISO date when the card data was produced" },
    "report": { "type": "string", "description": "Markdown report holding the raw evidence" },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/card" } }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": { "zh": { "type": "string" }, "en": { "type": "string" } }
    },
    "input": {
      "type": "object",
      "required": ["name", "required", "format"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Parameter / artifact name shown on the card" },
        "required": { "type": "boolean" },
        "format": { "$ref": "#/definitions/i18n", "description": "Accepted format(s)" },
        "note": { "$ref": "#/definitions/i18n" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["compression", "accuracy", "latency"],
      "additionalProperties": false,
      "properties": {
        "compression": { "$ref": "#/definitions/i18n", "description": "Size reduction range" },
        "accuracy": { "$ref": "#/definitions/i18n", "description": "Accuracy / PPL impact range" },
        "latency": { "$ref": "#/definitions/i18n", "description": "Latency improvement range" }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Optional measured result; omit when the method has not been run yet",
      "required": ["dataset", "summary"],
      "additionalProperties": false,
      "properties": {
        "dataset": { "type": "string" },
        "summary": { "$ref": "#/definitions/i18n" },
        "baseline_accuracy": { "type": ["number", "null"] },
        "result_accuracy": { "type": ["number", "null"] },
        "bytes_before": { "type": ["integer", "null"] },
        "bytes_after": { "type": ["integer", "null"] },
        "duration_s": { "type": ["number", "null"] },
        "report_anchor": { "type": "string" }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id", "label", "summary", "group", "calibration", "inputs",
        "suits", "effect", "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Must match the platform CompressionMethod enum",
          "enum": [
            "export_onnx", "export_gguf", "quantize_onnx", "quantize_onnx_static",
            "openvino_int8", "llm_quantize", "prune", "sparsify", "distill",
            "qat", "llm_finetune"
          ]
        },
        "label": { "$ref": "#/definitions/i18n" },
        "summary": { "$ref": "#/definitions/i18n", "description": "One-sentence description" },
        "group": {
          "type": "string",
          "enum": ["格式转换", "量化", "剪枝 / 稀疏化", "训练后校准"]
        },
        "calibration": {
          "type": "object",
          "required": ["needed", "note"],
          "additionalProperties": false,
          "properties": {
            "needed": { "type": "boolean" },
            "note": { "$ref": "#/definitions/i18n" }
          }
        },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/input" } },
        "suits": {
          "type": "object",
          "required": ["models", "tasks"],
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "array",
              "items": { "type": "string", "enum": ["cnn", "transformer", "llm", "tabular", "yolo", "pointnet"] }
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["image-classification", "object-detection", "tabular-classification", "text-generation", "point-cloud"]
              }
            }
          }
        },
        "effect": { "$ref": "#/definitions/effect" },
        "limits": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/i18n" } },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    }
  }
}
