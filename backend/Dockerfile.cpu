# CPU-only deployment image for "AI Model Lightweight Platform".
# Buildkit-free variant of Dockerfile (works with legacy builders too):
#  - no RUN --mount=... / no COPY --link
#  - uv installed via pip into the same python base image
#  - single `backend:latest` image serves both the FastAPI web app and the
#    Arq worker (different container commands).
FROM oven/bun:1 AS frontend-build

WORKDIR /app

COPY package.json bun.lock /app/
COPY frontend/package.json /app/frontend/

WORKDIR /app/frontend

RUN bun install

COPY ./frontend /app/frontend

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN bun run build


FROM python:3.11

# libGL/libglib: required by torchvision image ops (pulled in via ultralytics),
# which transformers qwen2 modeling imports at runtime.
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources     && apt-get update     && apt-get install -y --no-install-recommends libgl1 libglib2.0-0     && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PATH="/app/.venv/bin:$PATH"

# 降低 uv 并行度，避免在小内存 CPU 机器 / WSL 上构建时内存飙高
# （机器够强可自行调大：UV_CONCURRENT_DOWNLOADS=50 默认）
ENV UV_CONCURRENT_DOWNLOADS=8
ENV UV_CONCURRENT_BUILDS=1
ENV UV_CONCURRENT_INSTALLS=1
# 网络抖动时避免 hatchling/依赖下载 30s 超时导致构建失败
ENV UV_HTTP_TIMEOUT=120

# uv CLI (no BuildKit / multi-stage needed)
RUN pip install --no-cache-dir "uv==0.9.26"

WORKDIR /app/

# Workspace metadata so `uv sync` can resolve the "app" package deps up front.
COPY pyproject.toml uv.lock /app/
COPY backend/pyproject.toml /app/backend/pyproject.toml

# Install all runtime dependencies (torch / onnxruntime / openvino / ...).
# --no-dev: keep runtime images lean (skip mypy/ty/ruff dev tools).
RUN uv sync --frozen --no-dev --no-install-workspace --package app

COPY ./backend/scripts /app/backend/scripts
COPY ./backend/alembic.ini /app/backend/

COPY ./backend/app /app/backend/app

COPY --from=frontend-build /app/backend/app/frontend /app/backend/app/frontend

# Install the workspace package itself into the venv.
RUN uv sync --frozen --no-dev --package app

WORKDIR /app/backend/

CMD ["fastapi", "run", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
