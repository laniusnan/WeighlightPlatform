# ============================================================
# AI Model Lightweight Platform · CPU-only 部署环境变量
# 用法：
#   cp .env.cpu.example .env.cpu
#   把下面所有 <...> 占位替换为真实值（生成随机 secret）：
#     SECRET_KEY、POSTGRES_PASSWORD、FIRST_SUPERUSER_PASSWORD
#   可用：  openssl rand -hex 32     或     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# 启动：
#   docker compose -f compose.cpu.yml --env-file .env.cpu up -d --build
# ============================================================

# 平台名称（出现在页面标题 / 邮件主题 / OpenAPI 标题）
PROJECT_NAME=AI Model Lightweight Platform

# 生产模式：务必留空！留空时后端会强制校验密钥不得为 "changethis"。
# 仅本地试验可设为 development（此时会跳过该校验并打印警告）。
FASTAPI_ENV=

# ---- 密钥（必须替换，不能是 changethis）----
SECRET_KEY=
POSTGRES_PASSWORD=
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=

# 前端可访问地址（用于邮件中的链接与 CORS 白名单）
# 直连 IP 时改成 http://你的服务器IP:8001；有域名且用 Traefik 时改 https://域名
FRONTEND_HOST=http://localhost:8001

# ---- 邮件（可选）----
# 不配置 SMTP_HOST / EMAILS_FROM_EMAIL 则自动禁用发信（注册、找回密码仍可用，
# 只是不会收到邮件）。需要真实发信时填写你的 SMTP；或起本地 Mailpit：
#   docker compose -f compose.cpu.yml --profile email --env-file .env.cpu up -d
#   并把 SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# ---- 资源与配额（可选，默认值即可）----
# Web 进程数（CPU 建议 2）
WEB_CONCURRENCY=2
# Arq worker 同时执行的压缩任务数（CPU 建议 1；核多可调 2）
WORKER_MAX_JOBS=1
# 单文件下载上限（字节，默认 10GB）与每用户存储配额（默认 50GB，0=不限）
MAX_MODEL_DOWNLOAD_BYTES=10737418240
USER_STORAGE_QUOTA_BYTES=53687091200

# 错误监控（可选）
SENTRY_DSN=
